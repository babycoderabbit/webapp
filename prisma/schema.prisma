generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String?
  role       String   @default("USER")
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  settings       UserSettings?
  tasks          Task[]
  events         CalendarEvent[]
  habits         Habit[]
  habitLogs      HabitLog[]
  courses        Course[]
  timetableSlots TimetableSlot[]
  lectureNotes   LectureNote[]
  assignments    Assignment[]
  dictionary     DictionaryEntry[]
  documents      WritingDocument[]
  writingStreaks WritingStreak[]
  mediaItems     MediaItem[]
  transactions   Transaction[]
  budgets        Budget[]
  savingsGoals   SavingsGoal[]
}

model UserSettings {
  id             String @id @default(uuid())
  userId         String @unique
  theme          String @default("pure-black")
  accentColor    String @default("blue")
  timezone       String @default("Africa/Lagos")
  firstDayOfWeek String @default("Sunday")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String   @default("TODO") // TODO, IN_PROGRESS, COMPLETED
  dueDate     DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  isHoliday   Boolean  @default(false)
  isRecurring Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Habit {
  id         String   @id @default(uuid())
  userId     String
  title      String
  timeOfDay  String   @default("MORNING") // MORNING, AFTERNOON, EVENING
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitLogs HabitLog[]
}

model HabitLog {
  id      String   @id @default(uuid())
  habitId String
  userId  String
  date    String   // YYYY-MM-DD
  status  String   // COMPLETED, SKIPPED, FAILED

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model Course {
  id         String   @id @default(uuid())
  userId     String
  code       String
  title      String
  unit       Int      @default(3)
  instructor String?
  colorCode  String?
  createdAt  DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  timetableSlots TimetableSlot[]
  lectureNotes   LectureNote[]
  assignments    Assignment[]
}

model TimetableSlot {
  id         String @id @default(uuid())
  courseId   String
  userId     String
  dayOfWeek  Int    // 0-6
  startTime  String // HH:mm
  endTime    String // HH:mm
  roomOrLink String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LectureNote {
  id        String   @id @default(uuid())
  courseId  String
  userId    String
  title     String
  content   String   // Markdown text
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assignment {
  id       String   @id @default(uuid())
  courseId String
  userId   String
  title    String
  dueDate  DateTime?
  status   String   @default("NOT_DONE") // NOT_DONE, IN_PROGRESS, DONE
  grade    String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DictionaryEntry {
  id           String   @id @default(uuid())
  userId       String
  word         String
  partOfSpeech String?
  meaning      String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WritingDocument {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String   // Markdown
  wordCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WritingStreak {
  id           String @id @default(uuid())
  userId       String
  date         String // YYYY-MM-DD
  wordsWritten Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model MediaItem {
  id          String  @id @default(uuid())
  userId      String
  type        String  // MOVIE, SERIES, BOOK, GAME
  title       String
  creator     String? // Director/Author
  genre       String?
  releaseYear Int?
  country     String?
  progress    String? // e.g., page, episode, status
  rating      Int?    // 1-10
  status      String  @default("PLANNING") // PLANNING, IN_PROGRESS, COMPLETED, DROPPED

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  type        String   // INCOME, EXPENSE
  amount      Float
  category    String
  description String?
  date        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Budget {
  id           String @id @default(uuid())
  userId       String
  category     String
  monthlyLimit Float
  month        String // YYYY-MM

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month])
}

model SavingsGoal {
  id            String    @id @default(uuid())
  userId        String
  title         String
  targetAmount  Float
  currentAmount Float     @default(0)
  targetDate    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
